# =====================================
# FinanceAI Service 环境变量配置示例
# =====================================
# 使用说明:
# 1. 复制此文件为 .env
# 2. 填入实际的配置值
# 3. .env 文件不会被提交到 Git

# API密钥 (必填)
# 从 https://siliconflow.cn/ 获取您的API密钥
SILICONFLOW_API_KEY=your_api_key_here

# 应用配置 (可选)
APP_NAME=AcountAI
DEBUG=true
HOST=0.0.0.0
PORT=8000
